-def dot_product_attention(q, k, v, attn_mask=None, key_pad_mask=None, dropout=None):
+def dot_product_attention(q, k, v, attn_mask=None, key_pad_mask=None, dropout=None,
+                          need_attn_weights=False):
+    if not need_attn_weights and hasattr(F, "scaled_dot_product_attention"):
+        sdpa_mask = None
+        if key_pad_mask is not None:
+            sdpa_mask = ~key_pad_mask.unsqueeze(1).unsqueeze(2)
+            sdpa_mask = sdpa_mask.expand(-1, q.shape[1], q.shape[2], -1)
+        if attn_mask is not None:
+            am = ~attn_mask
+            sdpa_mask = am if sdpa_mask is None else sdpa_mask & am
+        drop_p = dropout.p if dropout is not None and dropout.training else 0.0
+        output = F.scaled_dot_product_attention(
+            q, k, v,
+            attn_mask=sdpa_mask.to(q.dtype) if sdpa_mask is not None and sdpa_mask.dtype == torch.bool else sdpa_mask,
+            dropout_p=drop_p,
+        )
+        return output, None
+
     c = q.shape[-1]
     attn = torch.matmul(q, k.transpose(-1, -2)) / math.sqrt(c)
 
